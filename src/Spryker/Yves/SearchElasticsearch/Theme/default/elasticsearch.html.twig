{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        {{ include('@WebProfiler/Icon/search.svg') }}
        <span class="sf-toolbar-value">Elasticsearch {{ collector.logs|length }}</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Calls</b>
            <span>{{ collector.logs|length }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, name: 'elasticsearch'}) }}
{% endblock %}

{% block menu %}
    <span class="label">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#AAA" d="M11.6.4A8 8 0 0 0 5.2 13L.8 17.5a1.3 1.3 0 0 0-.4.9c0 .3.1.6.4.9s.5.3.9.3c.3 0 .6 0 .9-.3l4.3-4.5a7.9 7.9 0 0 0 4.7 1.5 8 8 0 0 0 0-16zm5.5 8a5.5 5.5 0 0 1-5.5 5.4 5.5 5.5 0 1 1 5.5-5.5z"/></svg>
        </span>
        <strong>Elasticsearch</strong>
        <span class="count">
            <span>{{ collector.logs|length }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <style>
        .es-log-table {
            table-layout: auto;
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .es-log-table .col-shrink {
            white-space: nowrap;
            width: 1%;
        }
        .es-log-table .col-fill {
            width: 99%;
        }
        .es-log-table th {
            background: #2e3d50;
            color: #fff;
            padding: 9px 10px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .es-log-table td {
            padding: 8px 10px;
            vertical-align: top;
            border-bottom: none;
            background: transparent;
        }
        .es-log-table tbody tr.es-log-row-even td {
            background: rgba(255, 255, 255, 0.03);
        }
        .es-log-table code {
            background: #eef1f5;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 12px;
            color: #3c4c60;
        }
        .es-log-table pre {
            white-space: pre-wrap;
            word-wrap: break-word;
            margin: 0;
            font-size: 12px;
        }
        .es-log-details-row td {
            padding-top: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .es-log-details-cell {
            padding: 6px 10px 10px 10px;
        }
        .es-log-details-content {
            border-radius: 4px;
            padding: 10px 14px;
            margin-top: 4px;
            overflow-x: auto;
            max-height: 500px;
            overflow-y: auto;
        }
        .es-log-table details {
            padding-top: 4px;
        }
        .es-log-table details summary {
            display: inline-block;
            cursor: pointer;
            font-size: 12px;
            color: #ccc;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 3px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.06);
            user-select: none;
            transition: background 0.12s, border-color 0.12s, color 0.12s;
        }
        .es-log-table details summary:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.35);
            color: #fff;
        }
        .es-log-table details[open] summary {
            margin-bottom: 6px;
            background: #2e3d50;
            border-color: #2e3d50;
            color: #fff;
        }
        .es-log-empty {
            padding: 40px 20px;
            text-align: center;
            color: #999;
            font-size: 14px;
            border: 1px dashed #ddd;
            border-radius: 6px;
        }
        .es-log-actions {
            margin: 0 0 10px 0;
        }
        .es-log-copy-json {
            margin-left: 8px;
        }
        .es-log-toggle-row {
            margin-right: 8px;
        }
        .es-log-json-source {
            display: none;
        }
    </style>

    <h2>Elasticsearch Search Requests</h2>

    {% set logs = collector.logs %}

    {% if logs is empty %}
        <div class="es-log-empty">
            No Elasticsearch search requests were captured for this request.
        </div>
    {% else %}
        <div class="es-log-actions">
            <button type="button" class="btn btn-sm" data-profiler-toggle-all=".es-log-table">Expand all</button>
        </div>
        <table class="es-log-table">
            <thead>
                <tr>
                    <th class="col-shrink">#</th>
                    <th class="col-fill">Destination</th>
                </tr>
            </thead>
            <tbody>
                {% for i, log in logs %}
                    <tr class="{% if i is even %}es-log-row-even{% endif %}">
                        <td class="col-shrink">{{ i + 1 }}</td>
                        <td><code>{{ log.destination }}</code></td>
                    </tr>
                    <tr class="es-log-details-row {% if i is even %}es-log-row-even{% endif %}">
                        <td colspan="2" class="es-log-details-cell">
                            <button type="button" class="btn btn-sm es-log-toggle-row" data-profiler-toggle-row>Expand</button>
                            <details>
                                <summary>Show payload <button type="button" class="btn btn-sm es-log-copy-json" data-profiler-copy-json>Copy JSON</button></summary>
                                <textarea class="es-log-json-source" data-profiler-json-source readonly>{{ _self.renderJson(log.payload) }}</textarea>
                                <div class="es-log-details-content">
                                    {{ _self.renderLogValue(log.payload) }}
                                </div>
                            </details>
                            <details>
                                <summary>Show result <button type="button" class="btn btn-sm es-log-copy-json" data-profiler-copy-json>Copy JSON</button></summary>
                                <textarea class="es-log-json-source" data-profiler-json-source readonly>{{ _self.renderJson(log.result) }}</textarea>
                                <div class="es-log-details-content">
                                    {{ _self.renderLogValue(log.result) }}
                                </div>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <script>
        (function () {
            var copyText = function (text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text);
                }

                return new Promise(function (resolve, reject) {
                    var textarea = document.createElement('textarea');
                    textarea.value = text;
                    textarea.setAttribute('readonly', '');
                    textarea.style.position = 'fixed';
                    textarea.style.top = '-1000px';
                    document.body.appendChild(textarea);
                    textarea.select();

                    try {
                        document.execCommand('copy') ? resolve() : reject(new Error('Copy command was rejected.'));
                    } finally {
                        document.body.removeChild(textarea);
                    }
                });
            };

            var showCopyResult = function (button, label) {
                var originalLabel = button.getAttribute('data-original-label') || button.textContent;
                button.setAttribute('data-original-label', originalLabel);
                button.textContent = label;
                window.setTimeout(function () {
                    button.textContent = originalLabel;
                }, 2000);
            };

            document.querySelectorAll('[data-profiler-copy-json]').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    var source = button.closest('details').querySelector('[data-profiler-json-source]');

                    copyText(source.value).then(function () {
                        showCopyResult(button, 'Copied!');
                    }, function () {
                        showCopyResult(button, 'Copy failed');
                    });
                });
            });

            var setDumpNodesState = function (nodes, fromClass, toClass, arrow) {
                nodes.forEach(function (node) {
                    node.className = node.className.replace(new RegExp('\\b' + fromClass + '\\b'), toClass);

                    if (node.previousSibling && node.previousSibling.lastChild) {
                        node.previousSibling.lastChild.innerHTML = arrow;
                    }
                });
            };

            var expandNestedDumps = function (container) {
                setDumpNodesState(container.querySelectorAll('.sf-dump-compact'), 'sf-dump-compact', 'sf-dump-expanded', '\u25BC');
            };

            var collapseNestedDumps = function (container) {
                setDumpNodesState(container.querySelectorAll('.sf-dump-expanded .sf-dump-expanded'), 'sf-dump-expanded', 'sf-dump-compact', '\u25B6');
            };

            var initDetailsToggle = function (button, getDetails, expandLabel, collapseLabel) {
                var hasClosedDetails = function () {
                    return Array.prototype.some.call(getDetails(), function (details) {
                        return !details.open;
                    });
                };
                var refreshLabel = function () {
                    button.textContent = hasClosedDetails() ? expandLabel : collapseLabel;
                };

                button.addEventListener('click', function () {
                    var isOpen = hasClosedDetails();

                    getDetails().forEach(function (details) {
                        details.open = isOpen;

                        if (isOpen) {
                            expandNestedDumps(details);

                            return;
                        }

                        collapseNestedDumps(details);
                    });
                    refreshLabel();
                });
                document.addEventListener('toggle', refreshLabel, true);
            };

            document.querySelectorAll('[data-profiler-toggle-all]').forEach(function (button) {
                initDetailsToggle(button, function () {
                    return document.querySelectorAll(button.getAttribute('data-profiler-toggle-all') + ' details');
                }, 'Expand all', 'Collapse all');
            });

            document.querySelectorAll('[data-profiler-toggle-row]').forEach(function (button) {
                initDetailsToggle(button, function () {
                    return button.closest('td').querySelectorAll('details');
                }, 'Expand', 'Collapse');
            });
        })();
    </script>
{% endblock %}

{% macro renderLogValue(value) %}
    {% if value is iterable %}
        {{ profiler_dump(value) }}
    {% else %}
        <pre>{{ value }}</pre>
    {% endif %}
{% endmacro %}

{% macro renderJson(value) %}
    {%- set rawValue = value.getValue is defined ? value.getValue(true) : value -%}
    {%- if rawValue is iterable -%}
        {{ rawValue|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_INVALID_UTF8_SUBSTITUTE')) }}
    {%- else -%}
        {{ rawValue }}
    {%- endif -%}
{% endmacro %}
